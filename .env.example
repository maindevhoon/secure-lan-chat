# Local demo defaults to 127.0.0.1:7443.
# For a LAN host use its IPv4 address for both settings.
# CHAT_BIND=192.168.1.20
# CHAT_LAN_IP=192.168.1.20
# CHAT_PORT=7443

# Optional room key on the server. Clients enter it with --ask-key.
# CHAT_ROOM_KEY=

# Set these to id -u and id -g when needed for writable bind mounts on Linux.
# CHAT_UID=1000
# CHAT_GID=1000
